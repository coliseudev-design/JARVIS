# Development only. scripts/local-services.py generates private .local/dev.env.
APP_MODE=development
HOST=127.0.0.1
PORT=3001
# Required: distinct database roles for API, worker and migration.
# DATABASE_URL=
# WORKER_DATABASE_URL=
# MIGRATION_DATABASE_URL=
# REDIS_URL=
# AUTH_DATABASE_URL=
# APP_ENCRYPTION_KEY= # 64 hexadecimal characters, private; never commit a real value.
PUBLIC_ORIGIN=http://127.0.0.1:8080
# MAILBOX_PATH= # Private writable directory for local test delivery only.
